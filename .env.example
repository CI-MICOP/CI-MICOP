# Root-level environment reference for CI-MICOP.
#
# Actual environment files live in each service:
#   frontend/.env.example
#   backend/.env.example
#
# This file documents project-wide values shared conceptually across
# services (e.g. when running everything via Docker Compose in a later step).

# PostgreSQL (used by backend/.env DATABASE_URL and, later, docker-compose)
POSTGRES_USER=<username>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=ci_micop
POSTGRES_PORT=5432
