# General
ENVIRONMENT=development

# CORS - comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL only)
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/ci_micop

# Auth
JWT_SECRET_KEY=<replace-with-a-strong-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Document storage - defaults to <repo root>/infra/storage/documents if unset
# DOCUMENT_STORAGE_ROOT=/absolute/path/to/infra/storage/documents
# DOCUMENT_MAX_UPLOAD_BYTES=10485760

# Evidence storage - defaults to <repo root>/infra/storage/evidence if unset
# EVIDENCE_STORAGE_ROOT=/absolute/path/to/infra/storage/evidence
# EVIDENCE_MAX_UPLOAD_BYTES=10485760

# Step 5.4 risk-fusion artifacts (read-only) - defaults to <repo root>/ai_ml/model_artifacts if unset
# RISK_FUSION_ARTIFACTS_ROOT=/absolute/path/to/ai_ml/model_artifacts

# Step 5.8.12 document OCR - the Tesseract OCR *executable* (a separate,
# system-level install - pip installing pytesseract does NOT install it).
# Leave unset to use "tesseract" from PATH. Set only if it is installed
# elsewhere, e.g. on Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=/usr/bin/tesseract
